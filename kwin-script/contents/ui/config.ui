<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ScratchpadConfig</class>
 <widget class="QWidget" name="ScratchpadConfig">
  <layout class="QFormLayout" name="formLayout">
   <item row="0" column="0">
    <widget class="QLabel" name="terminalCommandLabel">
     <property name="text">
      <string>Terminal command:</string>
     </property>
     <property name="buddy">
      <cstring>kcfg_TerminalCommand</cstring>
     </property>
    </widget>
   </item>
   <item row="0" column="1">
    <widget class="QLineEdit" name="kcfg_TerminalCommand">
     <property name="placeholderText">
      <string>konsole</string>
     </property>
     <property name="toolTip">
      <string>Runs through sh, so arguments work: konsole --profile Scratchpad</string>
     </property>
    </widget>
   </item>
   <item row="1" column="0">
    <widget class="QLabel" name="terminalWindowClassLabel">
     <property name="text">
      <string>Terminal window class:</string>
     </property>
     <property name="buddy">
      <cstring>kcfg_TerminalWindowClass</cstring>
     </property>
    </widget>
   </item>
   <item row="1" column="1">
    <widget class="QLineEdit" name="kcfg_TerminalWindowClass">
     <property name="placeholderText">
      <string>Leave empty to use the program name</string>
     </property>
     <property name="toolTip">
      <string>Part of the window class or app id of the terminal, e.g. "wezterm". Only needed when the command doesn't start with the terminal's name (flatpak run ...).</string>
     </property>
    </widget>
   </item>
   <item row="2" column="0">
    <widget class="QLabel" name="widthLabel">
     <property name="text">
      <string>Width:</string>
     </property>
     <property name="buddy">
      <cstring>kcfg_WidthPercent</cstring>
     </property>
    </widget>
   </item>
   <item row="2" column="1">
    <widget class="QSpinBox" name="kcfg_WidthPercent">
     <property name="suffix">
      <string>% of the screen</string>
     </property>
     <property name="minimum">
      <number>10</number>
     </property>
     <property name="maximum">
      <number>100</number>
     </property>
     <property name="value">
      <number>60</number>
     </property>
    </widget>
   </item>
   <item row="3" column="0">
    <widget class="QLabel" name="heightLabel">
     <property name="text">
      <string>Height:</string>
     </property>
     <property name="buddy">
      <cstring>kcfg_HeightPercent</cstring>
     </property>
    </widget>
   </item>
   <item row="3" column="1">
    <widget class="QSpinBox" name="kcfg_HeightPercent">
     <property name="suffix">
      <string>% of the screen</string>
     </property>
     <property name="minimum">
      <number>10</number>
     </property>
     <property name="maximum">
      <number>100</number>
     </property>
     <property name="value">
      <number>60</number>
     </property>
    </widget>
   </item>
   <item row="4" column="0" colspan="2">
    <widget class="QCheckBox" name="kcfg_UseFocusedWindowWhenEmpty">
     <property name="text">
      <string>When the scratchpad is empty, Meta+S takes the focused window instead of opening a terminal</string>
     </property>
    </widget>
   </item>
   <item row="5" column="0" colspan="2">
    <widget class="QLabel" name="applyHintLabel">
     <property name="text">
      <string>Changes apply the next time KWin loads the script: turn it off and on again here, or log out and back in.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
  </layout>
